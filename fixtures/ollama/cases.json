    {
      "id": "openai_tool_route_history",
      "source": "integration/tools_routes_test.go#runOpenAIChatToolRoute",
      "request": {
        "model": "test-model",
        "messages": [
          {
            "role": "system",
            "content": "Tool protocol compatibility test."
          },
          {
            "role": "developer",
            "content": "When the user asks for weather, call get_weather. Return only the tool call and do not answer in text."
          },
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Call get_weather for Paris."
              }
            ]
          },
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_previous",
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "arguments": "{\"location\":\"Paris\"}"
                }
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_previous",
            "content": [
              {
                "type": "text",
                "text": "{\"condition\":\"sunny\"}"
              }
            ]
          },
          {
            "role": "user",
            "content": "Now call get_weather with location exactly Boston. Return only the tool call."
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get the current weather for a location",
              "parameters": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string"
                  }
                },
                "required": [
                  "location"
                ]
              }
            }
          }
        ],
        "temperature": 0,
        "max_tokens": 256,
        "reasoning_effort": "none"
      },
      "expected_messages": [
        {
          "role": "system",
          "content": "Tool protocol compatibility test.\n\nWhen the user asks for weather, call get_weather. Return only the tool call and do not answer in text."
        },
        {
          "role": "user",
          "content": "Call get_weather for Paris."
        },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "call_previous",
              "type": "function",
              "function": {
                "name": "get_weather",
                "arguments": {
                  "location": "Paris"
                }
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_previous",
          "content": "{\"condition\":\"sunny\"}"
        },
        {
          "role": "user",
          "content": "Now call get_weather with location exactly Boston. Return only the tool call."
        }
      ],
      "expected_calls": [
        {
          "name": "get_weather",
          "arguments": {
            "location": "Boston"
          }
        }
      ]
    }
  ],
